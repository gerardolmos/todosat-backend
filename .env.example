HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Límite máximo de un pedido antes de impuestos y envío.
# Valor expresado en céntimos. 10000000 = 100.000 EUR.
CHECKOUT_MAX_TOTAL_CENTIMOS=10000000

# Stripe Checkout
# Mantener test hasta superar las revisiones técnica y legal.
STRIPE_MODE=test

# Cortacircuitos: debe seguir en false durante desarrollo y pruebas.
CHECKOUT_LIVE_ENABLED=false

# No escribir secretos reales en este archivo ni en Git.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe sustituirá el marcador por el identificador de la sesión.
CHECKOUT_SUCCESS_URL=http://localhost:4321/tienda/compra/confirmacion?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:4321/tienda/carrito?checkout=cancelado

# Caducidad del pedido provisional.
# Mínimo 30 y máximo 1440 minutos.
CHECKOUT_ORDER_EXPIRY_MINUTES=60

# Activación controlada del endpoint público de checkout.
# Debe continuar en false hasta ejecutar las pruebas de integración.
CHECKOUT_PUBLIC_ENABLED=false
CHECKOUT_STATUS_PUBLIC_ENABLED=false
CHECKOUT_STATUS_RATE_LIMIT_MAX=20
CHECKOUT_STATUS_RATE_LIMIT_WINDOW_MS=300000

# Protección básica contra peticiones automatizadas.
CHECKOUT_RATE_LIMIT_MAX=10
CHECKOUT_RATE_LIMIT_WINDOW_MS=300000

# Validación pública del carrito.
# No crea pedidos, no contacta con Stripe y permanece desactivada por defecto.
CART_VALIDATION_PUBLIC_ENABLED=false
CART_VALIDATION_RATE_LIMIT_MAX=30
CART_VALIDATION_RATE_LIMIT_WINDOW_MS=300000

# CORS del frontend
# Producción:
# CORS_ALLOWED_ORIGINS=https://todosatcom.com,https://www.todosatcom.com
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
