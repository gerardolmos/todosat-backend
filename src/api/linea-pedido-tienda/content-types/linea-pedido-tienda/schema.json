{
  "kind": "collectionType",
  "collectionName": "lineas_pedido_tienda",
  "info": {
    "singularName": "linea-pedido-tienda",
    "pluralName": "lineas-pedido-tienda",
    "displayName": "Líneas de pedido de tienda",
    "description": "Copia histórica e inmutable de los productos comprados"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "pedido_tienda": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::pedido-tienda.pedido-tienda",
      "inversedBy": "lineas_pedido_tienda",
      "required": true
    },
    "producto_tienda": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::producto-tienda.producto-tienda"
    },
    "producto_document_id": {
      "type": "string",
      "required": true,
      "maxLength": 255,
      "private": true
    },
    "sku": {
      "type": "string",
      "required": true,
      "maxLength": 100,
      "private": true
    },
    "referencia_proveedor": {
      "type": "string",
      "required": true,
      "maxLength": 160,
      "private": true
    },
    "nombre_producto": {
      "type": "string",
      "required": true,
      "maxLength": 180,
      "private": true
    },
    "tipo_producto": {
      "type": "enumeration",
      "enum": [
        "Producto principal",
        "Accesorio"
      ],
      "required": true,
      "private": true
    },
    "cantidad": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 20,
      "private": true
    },
    "precio_unitario_centimos": {
      "type": "integer",
      "required": true,
      "min": 0,
      "private": true
    },
    "subtotal_centimos": {
      "type": "integer",
      "required": true,
      "min": 0,
      "private": true
    },
    "impuestos_centimos": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 0,
      "private": true
    },
    "total_centimos": {
      "type": "integer",
      "required": true,
      "min": 0,
      "private": true
    },
    "moneda": {
      "type": "enumeration",
      "enum": [
        "EUR"
      ],
      "required": true,
      "default": "EUR",
      "private": true
    },
    "requiere_envio": {
      "type": "boolean",
      "required": true,
      "default": true,
      "private": true
    }
  }
}
