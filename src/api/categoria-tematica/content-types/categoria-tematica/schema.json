{
  "kind": "collectionType",
  "collectionName": "categoria_tematicas",
  "info": {
    "singularName": "categoria-tematica",
    "pluralName": "categoria-tematicas",
    "displayName": "categoria-tematica"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre"
    },
    "descripcion": {
      "type": "text",
      "maxLength": 300
    },
    "icono": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "activa": {
      "type": "boolean",
      "default": true
    },
    "articulos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::articulo.articulo",
      "mappedBy": "categoria_tematica"
    }
  }
}
