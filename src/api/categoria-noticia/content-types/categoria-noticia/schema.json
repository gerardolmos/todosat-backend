{
  "kind": "collectionType",
  "collectionName": "categoria_noticias",
  "info": {
    "singularName": "categoria-noticia",
    "pluralName": "categoria-noticias",
    "displayName": "Categorías de noticias"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "descripcion": {
      "type": "text",
      "maxLength": 300
    },
    "icono": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "activa": {
      "type": "boolean",
      "default": true
    },
    "noticias": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::noticia.noticia",
      "mappedBy": "categoria_noticia"
    }
  }
}
