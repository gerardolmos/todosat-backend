{
  "kind": "collectionType",
  "collectionName": "categorias_productos_tienda",
  "info": {
    "singularName": "categoria-producto-tienda",
    "pluralName": "categorias-productos-tienda",
    "displayName": "Categorías de productos de tienda"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "descripcion": {
      "type": "text",
      "maxLength": 300
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "activa": {
      "type": "boolean",
      "default": true
    },
    "orden": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "productos_tienda": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::producto-tienda.producto-tienda",
      "mappedBy": "categoria_producto_tienda"
    }
  }
}
