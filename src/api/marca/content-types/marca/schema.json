{
  "kind": "collectionType",
  "collectionName": "marcas",
  "info": {
    "singularName": "marca",
    "pluralName": "marcas",
    "displayName": "Operadores"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "imagen_portada": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "descripcion_corta": {
      "type": "string",
      "maxLength": 40,
      "required": true
    },
    "descripcion_completa": {
      "type": "blocks"
    },
    "web_oficial": {
      "type": "string"
    },
    "pais_origen": {
      "type": "string",
      "maxLength": 60
    },
    "activa": {
      "type": "boolean",
      "default": true
    },
    "modelos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::modelo.modelo",
      "mappedBy": "marca"
    },
    "articulos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::articulo.articulo",
      "mappedBy": "marcas"
    },
    "manuals": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::manual.manual",
      "mappedBy": "marcas"
    },
    "descripcion_home": {
      "type": "text",
      "maxLength": 135
    },
    "cobertura": {
      "type": "string"
    },
    "satelites": {
      "type": "string"
    },
    "latencia": {
      "type": "string"
    },
    "velocidad": {
      "type": "string"
    },
    "cobertura_descripcion": {
      "type": "string"
    },
    "orbita_descripcion": {
      "type": "string"
    },
    "satelites_descripcion": {
      "type": "string"
    },
    "latencia_descripcion": {
      "type": "string"
    },
    "velocidad_descripcion": {
      "type": "string"
    },
    "tipo_orbita": {
      "type": "string"
    }
  }
}