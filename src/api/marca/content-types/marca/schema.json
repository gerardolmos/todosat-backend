{
  "kind": "collectionType",
  "collectionName": "marcas",
  "info": {
    "singularName": "marca",
    "pluralName": "marcas",
    "displayName": "marca"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "imagen_portada": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "descripcion_corta": {
      "type": "text",
      "minLength": 20,
      "maxLength": 300,
      "required": true
    },
    "descripcion_completa": {
      "type": "blocks"
    },
    "web_oficial": {
      "type": "string"
    },
    "tipo_orbita": {
      "type": "enumeration",
      "enum": [
        "LEO",
        "MEO",
        "GEO",
        "hibrida",
        "desconocida"
      ]
    },
    "pais_origen": {
      "type": "string",
      "maxLength": 60
    },
    "activa": {
      "type": "boolean",
      "default": true
    },
    "modelos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::modelo.modelo",
      "mappedBy": "marca"
    },
    "articulos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::articulo.articulo",
      "mappedBy": "marcas"
    },
    "manuals": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::manual.manual",
      "mappedBy": "marcas"
    }
  }
}
